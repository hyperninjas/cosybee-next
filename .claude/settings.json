{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/heroui-version.sh\"",
            "timeout": 180,
            "statusMessage": "Checking HeroUI version..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__heroui-react__.*|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/heroui-consulted.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/heroui-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking HeroUI gate..."
          }
        ]
      }
    ]
  }
}
