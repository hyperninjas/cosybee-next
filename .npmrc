# Refuse installs on a Node/npm outside package.json "engines" (Node 24 / npm 11).
# npm 10 and npm 11 disagree on which optional entries (e.g. @emnapi/*) belong in
# package-lock.json, so a lockfile written by the wrong major fails `npm ci` in
# the Docker build, which runs the npm from .nvmrc's Node version.
engine-strict=true
